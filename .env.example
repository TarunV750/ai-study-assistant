# Copy to .env for local development. Never commit real values.
AWS_REGION=us-east-1
DOCUMENTS_BUCKET_NAME=
OPENSEARCH_COLLECTION_ENDPOINT=
OPENSEARCH_INDEX_NAME=study-assistant-chunks
BEDROCK_EMBEDDING_MODEL_ID=
BEDROCK_GENERATION_MODEL_ID=
MAX_UPLOAD_SIZE_BYTES=10485760
UPLOAD_URL_EXPIRATION_SECONDS=300
MAX_PDF_PAGES=200
MAX_EXTRACTED_CHARACTERS=2000000
CHUNK_SIZE_CHARACTERS=1200
CHUNK_OVERLAP_CHARACTERS=200
MAX_CHUNKS_PER_DOCUMENT=5000
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
NORMALIZE_EMBEDDINGS=true
MAX_EMBEDDING_CHUNKS=500
MAX_CHUNKS_FILE_SIZE_BYTES=52428800
FRONTEND_ORIGIN=http://localhost:5173
